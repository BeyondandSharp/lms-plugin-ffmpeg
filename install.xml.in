<?xml version="1.0"?>
<!-- Template: rendered to build/install.xml from VERSION by build.sh. -->
<extension>
	<name>PLUGIN_FFMPEG</name>
	<module>Plugins::FFmpeg::Plugin</module>
	<version>@VERSION@</version>
	<description>PLUGIN_FFMPEG_DESCRIPTION</description>
	<creator>Lyrion Community</creator>
	<category>tools</category>

	<defaultState>enabled</defaultState>

	<optionsURL>plugins/FFmpeg/settings.html</optionsURL>
	<type>2</type>

	<targetApplication>
		<id>Lyrion Music Server</id>
		<minVersion>9.0.0</minVersion>
		<maxVersion>9.*</maxVersion>
	</targetApplication>
</extension>
